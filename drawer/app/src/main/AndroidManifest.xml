<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Weather tile (Open-Meteo, approximate location only). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Day tile: daily steps (Health Services) and the next calendar event. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Control panel brightness (a special permission you grant once). -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Flick presets tile: read + select presets (Flick only lets apps signed with the same key do this). -->
    <uses-permission android:name="com.rusty.flick.permission.PRESETS" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.rusty.flick" />
    </queries>

    <application
        android:icon="@drawable/app_icon"
        android:roundIcon="@drawable/app_icon"
        android:label="@string/app_name"
        android:theme="@style/Nightfall">
        <meta-data android:name="com.google.android.wearable.standalone" android:value="true" />

        <!-- One host for the drawer, the notification inbox and the control panel. It stays alive in the background,
             so the swipe redirects bring it to the front instantly (no splash, no reload). -->
        <activity
            android:name=".NightfallActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.rusty.nightfall.surfaces"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|uiMode|keyboardHidden" />

        <!-- The launcher / side-button entry ("Nightfall Drawer"). Same name as before, so a button mapping keeps working. -->
        <activity-alias
            android:name=".DrawerActivity"
            android:exported="true"
            android:label="@string/drawer_name"
            android:targetActivity=".NightfallActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Opens the control panel (used by tiles' "set up" links). -->
        <activity-alias
            android:name=".PanelActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:targetActivity=".NightfallActivity" />

        <activity
            android:name=".FlashlightActivity"
            android:exported="false"
            android:theme="@style/Nightfall.Flashlight"
            android:excludeFromRecents="true" />

        <service
            android:name=".SwipeRedirectService"
            android:label="@string/a11y_name"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/swipe_redirect" />
        </service>

        <service
            android:name=".NotifListener"
            android:label="@string/app_name"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".StepsService"
            android:exported="true"
            android:permission="com.google.android.wearable.healthservices.permission.PASSIVE_DATA_BINDING" />

        <service
            android:name=".DayTileService"
            android:exported="true"
            android:label="@string/tile_day"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data android:name="androidx.wear.tiles.PREVIEW" android:resource="@drawable/app_icon" />
        </service>
        <service
            android:name=".WeatherTileService"
            android:exported="true"
            android:label="@string/tile_weather"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data android:name="androidx.wear.tiles.PREVIEW" android:resource="@drawable/app_icon" />
        </service>
        <service
            android:name=".MusicTileService"
            android:exported="true"
            android:label="@string/tile_music"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data android:name="androidx.wear.tiles.PREVIEW" android:resource="@drawable/app_icon" />
        </service>
        <service
            android:name=".FlickTileService"
            android:exported="true"
            android:label="@string/tile_flick"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data android:name="androidx.wear.tiles.PREVIEW" android:resource="@drawable/app_icon" />
        </service>
    </application>
</manifest>
